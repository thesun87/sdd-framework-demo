{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "Nest API — dựng khung ở T001, chưa có mã sản phẩm.",
  "type": "commonjs",
  "scripts": {
    "test": "jest --passWithNoTests",
    "lint": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@nestjs/core": "11.2.5",
    "@nestjs/common": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "jest": "30.4.2",
    "ts-jest": "29.4.12",
    "@types/jest": "30.0.0",
    "supertest": "7.2.2",
    "@types/supertest": "7.2.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$"
  }
}
