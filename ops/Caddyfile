# ops/Caddyfile — Caddy là điểm publish HTTP DUY NHẤT ra ngoài (AD-8: một origin cho cả
# bán hàng lẫn quản trị). Rủi ro của quyết định đó chính là lý do CSP dưới đây phải chặt.
#
# AD-29: "một bề mặt tồn tại trước lớp phòng thủ của nó là một cửa sổ không ai đóng lại."
# Header an toàn phải có mặt trên CẢ HAI đường dẫn — bán hàng và quản trị — NGAY BÂY GIỜ,
# dù `/admin/*` ở feature 000 chưa có bundle nào phía sau. Khi 006 cắm bundle admin vào,
# nó không được phép và không cần đặt lại lớp phòng thủ này (AD-9).
#
# Cổng backend `api`: ops/compose.yaml (T002) hiện KHÔNG đưa biến API_PORT vào container
# `proxy` (không có `environment:`/`env_file:` cho service này) — việc bơm biến đó vào
# `proxy` bị hoãn lại, đã ghi vào ledger (ruling R14). Dùng placeholder có giá trị mặc định
# `{$API_PORT:3000}`: khi biến chưa tồn tại trong container (đúng thực tế hôm nay), Caddy
# rơi về 3000 — giá trị mặc định lấy từ ops/.env.example (API_PORT=3000), không tệ hơn việc
# ghi cứng. Khi một task sau này bơm API_PORT vào service `proxy`, Caddyfile tự đúng theo,
# không cần sửa chéo task.
{
	# Container này không cần Caddy admin API — tắt để giảm bề mặt tấn công.
	admin off
}

# Khối header an toàn dùng chung, import vào site block DUY NHẤT bên dưới — tránh lặp ba
# lần cùng một danh sách directive (yêu cầu "giữ file đọc được" trong brief). Nội dung
# nguyên văn theo contract/AD-29 — không thêm, không bớt directive nào.
#
# 'unsafe-inline' CHỈ xuất hiện ở style-src (nhượng bộ baseline cho style nội tuyến của
# Vite). script-src không nới lỏng eval hay script nội tuyến, không trỏ tới CDN ngoài.
(security_headers) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; connect-src 'self'; style-src 'self' 'unsafe-inline'"
		Referrer-Policy "same-origin"
		X-Content-Type-Options "nosniff"
	}
}

:80 {
	# `header` nằm ở top-level của site block (không lồng riêng trong từng `handle`) nên áp
	# dụng cho MỌI nhánh bên dưới, kể cả nhánh lỗi (404 của /admin[/*], 502/503 khi /api[/*]
	# không có backend sống) — đây chính là phần nhiều cấu hình Caddy làm sai (brief đã cảnh báo).
	import security_headers

	# /api/* — luôn chuyển tới NestJS, KHÔNG BAO GIỜ rơi vào SPA fallback, kể cả khi backend
	# trả 404 hoặc không phản hồi được. Route này đứng TRƯỚC route tệp tĩnh trong Caddyfile,
	# và `handle` là khối loại trừ lẫn nhau theo thứ tự khai báo, nên `/api/*` không thể rơi
	# xuống nhánh SPA fallback (edge case ghi trong spec.md §Edge Cases).
	#
	# Named matcher liệt kê CẢ hai dạng `/api` (không có "/" cuối) và `/api/*` — matcher path
	# kiểu `/api/*` chỉ khớp tiền tố có dấu "/" theo sau, KHÔNG khớp đường dẫn trần `/api`.
	# Thiếu dạng trần, `/api` sẽ rơi xuống fallback SPA — đúng chỗ hổng review vòng 1 phát
	# hiện (`handle /api /api/*` không hợp lệ — `handle` không nhận nhiều path trần cùng lúc,
	# phải khai matcher riêng để OR hai pattern).
	#
	# Cache-Control của /api/* KHÔNG đặt ở đây — API tự đặt `no-store` (T010/T011 sở hữu,
	# AD-20). Proxy không ghi đè, không thêm cache cho đường dẫn này.
	@api path /api /api/*
	handle @api {
		reverse_proxy api:{$API_PORT:3000}
	}

	# /admin/* — ở feature 000 chưa có bundle admin nào phía sau. Trả 404 là hợp lý, nhưng
	# vẫn phải mang đủ header an toàn ở trên (AD-29) — đây là bề mặt phải có phòng thủ
	# trước khi có nội dung, không phải sau.
	#
	# Named matcher liệt kê CẢ hai dạng `/admin` và `/admin/*` — cùng lý do trên: đường dẫn
	# trần `/admin` (không "/" cuối, thứ người dùng thật hay gõ) phải không rơi xuống fallback
	# SPA.
	@admin path /admin /admin/*
	handle @admin {
		respond 404
	}

	# /images/* — ảnh sản phẩm (T011b, Ruling R22 ở progress.md): `product_image.path` lưu
	# đường dẫn TRÊN ĐĨA (đúng AD-15 — ảnh trên hệ tệp, không blob), nhưng tầng trình bày
	# (`catalog.service.ts`) đã ánh xạ giá trị đó thành URL `/images/<tên tệp hoặc thư mục
	# con/tên tệp>` trong mọi response HTTP. Route này biến URL đó thành tệp thật — đọc từ
	# CHÍNH volume `product-images` đã mount READ-ONLY vào dịch vụ `proxy` này
	# (`ops/compose.yaml`), tức là CÙNG một origin (AD-8): không CDN, không origin thứ hai.
	#
	# Đặt sau `@api`/`@admin` ở trên (thứ tự không quan trọng — path prefix của ba nhánh khác
	# nhau nên không nhánh nào che nhánh kia — chỉ đặt gần nhau cho dễ đọc), và TRƯỚC nhánh SPA
	# fallback bên dưới để `/images/*` không bao giờ rơi vào `index.html`.
	#
	# `{$PRODUCT_IMAGE_PATH:/data/product-images}` — cùng kiểu placeholder-có-mặc-định mà
	# `reverse_proxy api:{$API_PORT:3000}` ở trên đã dùng, cùng lý do: biến này KHÔNG được bơm
	# vào container `proxy` qua `environment:`/`env_file:` (chỉ dùng để resolve đường dẫn mount
	# ở `ops/compose.yaml`, phía host); mặc định khớp đúng
	# `${PRODUCT_IMAGE_PATH:-/data/product-images}` mà compose file đó dùng.
	#
	# `uri strip_prefix /images` bỏ tiền tố `/images` khỏi đường dẫn TRƯỚC khi `file_server`
	# tra trong `root` — Caddy áp dụng `root`/`uri`/`file_server` theo thứ tự ưu tiên cố định
	# của chính nó (không theo thứ tự dòng viết trong file), nên `/images/ca-phe-sua-da.jpg`
	# map đúng tới `<mount>/ca-phe-sua-da.jpg`; một ảnh ở thư mục con (`/images/x/y.jpg`) vẫn
	# map đúng tới `<mount>/x/y.jpg` — không giả định ảnh luôn nằm phẳng ở gốc mount.
	@images path /images/*
	handle @images {
		root * {$PRODUCT_IMAGE_PATH:/data/product-images}
		uri strip_prefix /images
		file_server
	}

	# Còn lại: tệp tĩnh của storefront; không khớp tệp nào thì SPA fallback về index.html.
	handle {
		root * /srv/storefront
		try_files {path} /index.html
		file_server
	}
}
