# ops/.env.example — bản kê DUY NHẤT của cấu hình triển khai (Ruling R4).
# Copy thành `ops/.env` cho máy dev thật. KHÔNG commit `.env` thật.
# Bốn tên biến dưới đây đã chốt — sáu task sau tiêu thụ đúng bốn tên này, không đặt tên khác.

# Chuỗi kết nối PostgreSQL đầy đủ. Cổng 5432 được publish ra host (xem ops/compose.yaml) nên
# Jest chạy TRÊN HOST nối thẳng vào được (database vẫn chạy trong container). Dịch vụ `api`
# bên trong mạng compose override giá trị này để dùng tên dịch vụ `postgres` thay vì
# `localhost` — xem comment tương ứng trong ops/compose.yaml.
DATABASE_URL=postgres://app:app@localhost:5432/shop

# Cổng NestJS lắng nghe BÊN TRONG mạng compose. Không publish ra host — chỉ `proxy` nói
# chuyện trực tiếp với `api` (AD-8: một origin, một cổng HTTP publish ra ngoài).
API_PORT=3000

# development | production
NODE_ENV=development

# Đường dẫn thư mục ảnh sản phẩm trên named volume. AD-15: ảnh nằm trên hệ tệp, không phải
# blob trong database.
PRODUCT_IMAGE_PATH=/data/product-images
